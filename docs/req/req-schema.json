{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/stock-insider/docs/req/req-schema.json",
  "title": "Stock Insider Requirements Registry Schema",
  "description": "CI validation schema for docs/req/requirements.yaml (course D1, schema gate D7-3). Validates registry structure, ID format, type/priority discipline, invariant zero-tolerance rules, and metric+threshold+verification form of non-functional requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "requirements"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["project", "registry_version", "language_policy"],
      "additionalProperties": true,
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "registry_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "id_prefix": { "type": "string", "pattern": "^[A-Z]+(-[A-Z]+)*$" },
        "classification": { "type": "string" },
        "markets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "language_policy": { "type": "string", "minLength": 10 },
        "scope_must_do": { "$ref": "#/definitions/stringArray" },
        "scope_must_not_do": { "$ref": "#/definitions/stringArray" },
        "scope_out_of_scope": { "$ref": "#/definitions/stringArray" }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/requirement" }
    }
  },
  "definitions": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "statement",
        "fit_criterion",
        "priority",
        "tradeoff",
        "source",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REQ-SI-(FR|INV|QA|PERF|COST|GOV|SEC)-[0-9]{3}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "functional",
            "invariant",
            "quality",
            "performance",
            "cost",
            "governance",
            "security"
          ]
        },
        "statement": { "type": "string", "minLength": 20 },
        "fit_criterion": { "type": "string", "minLength": 20 },
        "metric": { "type": "string" },
        "threshold": { "type": ["string", "number"] },
        "verification": { "type": "string" },
        "priority": {
          "type": "string",
          "enum": ["Must", "Should", "Could", "Won't"]
        },
        "tradeoff": { "type": "string", "minLength": 5 },
        "source": { "type": "string", "minLength": 3 },
        "status": {
          "type": "string",
          "enum": ["implemented", "conceptual", "future", "deprecated"]
        },
        "zero_tolerance": { "type": "boolean" },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^REQ-SI-(FR|INV|QA|PERF|COST|GOV|SEC)-[0-9]{3}$"
          }
        },
        "regression_trigger": { "type": "boolean" },
        "regression_scope": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$" }
        },
        "superseded_by": {
          "type": "string",
          "pattern": "^REQ-SI-(FR|INV|QA|PERF|COST|GOV|SEC)-[0-9]{3}$"
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "invariant" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "priority": { "const": "Must" },
              "zero_tolerance": { "const": true }
            },
            "required": ["zero_tolerance"]
          }
        },
        {
          "if": {
            "properties": {
              "type": { "enum": ["quality", "performance", "cost"] }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["metric", "threshold", "verification"]
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "future" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "regression_trigger": { "const": false } }
          }
        }
      ]
    },
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
